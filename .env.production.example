# Deploy the browser app and the Express/Socket.IO API on HTTPS origins; set CLIENT_URL to the browser origin and VITE_API_URL to the API origin.
NODE_ENV=production
PORT=4000
CLIENT_URL=https://app.example.com
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.com/emberserve?retryWrites=true&w=majority
JWT_ACCESS_SECRET=replace-with-a-unique-32-plus-character-production-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-unique-32-plus-character-production-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_DOMAIN=app.example.com
COOKIE_SECURE=true
RAZORPAY_KEY_ID=rzp_live_replace_me
RAZORPAY_KEY_SECRET=replace-with-live-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-live-razorpay-webhook-secret
RESEND_API_KEY=re_replace_with_transactional_email_api_key
RESEND_FROM_EMAIL=reservations@yourdomain.example
RESERVATION_NOTIFICATION_EMAIL=reservations@yourdomain.example
RESTAURANT_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info
TRUST_PROXY=true
ALLOW_PRODUCTION_SEED=false
VITE_API_URL=https://api.example.com
