# Base URL of the EmberServe API. The client appends /api/v1 when necessary.
VITE_API_URL=http://localhost:4000
# Firebase web configuration is public. Generate this from Firebase Console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
