# Copy this file to .env for local development. Values here are deliberately
# non-production placeholders; generate unique secrets before any deployment.
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/emberserve

# Use independent, high-entropy values (at least 32 characters) in every env.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Razorpay test credentials only for local/staging environments.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-razorpay-test-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-a-webhook-secret

RESTAURANT_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info
# Set true only when Express is behind a trusted reverse proxy/load balancer.
TRUST_PROXY=false
# `npm run seed` uses this only in development. Never enable production seed
# creation unless intentionally bootstrapping a disposable demo environment.
SEED_DEMO_PASSWORD=demo-password
ALLOW_PRODUCTION_SEED=false
UPLOAD_PROVIDER=local
UPLOAD_PATH=./uploads
MAX_UPLOAD_SIZE=5242880

# Vite exposes only VITE_* variables to browser code. In production the web
# container is built with /api/v1 and Nginx proxies that route to the API.
VITE_API_URL=http://localhost:4000
