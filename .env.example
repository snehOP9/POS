NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/emberserve
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-razorpay-test-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-a-webhook-secret

RESTAURANT_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info
TRUST_PROXY=false
SEED_DEMO_PASSWORD=demo-password
ALLOW_PRODUCTION_SEED=false
UPLOAD_PROVIDER=local
UPLOAD_PATH=./uploads
MAX_UPLOAD_SIZE=5242880
VITE_API_URL=http://localhost:4000
