FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY backend/package.json backend/package.json
COPY frontend/package.json frontend/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN npm ci

COPY tsconfig.base.json ./
COPY backend ./backend
COPY packages/shared ./packages/shared
RUN npm run build --workspace=@emberserve/shared \
  && npm run build --workspace=@emberserve/api
RUN npm prune --omit=dev
FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 ember

COPY --from=build --chown=ember:nodejs /app/node_modules ./node_modules
COPY --from=build --chown=ember:nodejs /app/package.json ./package.json
COPY --from=build --chown=ember:nodejs /app/backend/package.json ./backend/package.json
COPY --from=build --chown=ember:nodejs /app/backend/dist ./backend/dist
COPY --from=build --chown=ember:nodejs /app/packages/shared/package.json ./packages/shared/package.json
COPY --from=build --chown=ember:nodejs /app/packages/shared/dist ./packages/shared/dist

USER ember
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:4000/health || exit 1

CMD ["npm", "run", "start", "--workspace=@emberserve/api"]
